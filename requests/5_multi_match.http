POST http://localhost:9200/products/_search
Content-Type: application/json

{
  "query": {
    "multi_match": {
      "query": "Nike running shoes",
      "fields": [
        "name^3",
        "description",
        "brand"
      ],
      "type": "best_fields",
      "operator": "or"
    }
  },
  "size": 100
}